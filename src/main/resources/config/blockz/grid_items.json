  "_info": [
    "占格物品配置文件 (Grid Items Configuration)",
    "",
    "格式说明:",
    "\"模组ID:物品ID\": {",
    "  \"width\": 物品在背包中的宽度 (必填, 整数)",
    "  \"height\": 物品在背包中的高度 (必填, 整数)",
    "  \"cap_width\": 容量网格宽度 (必填, 整数, 仅对容器有效)",
    "  \"cap_height\": 容量网格高度 (必填, 整数, 仅对容器有效)",
    "}",
    "",
    "容量说明:",
    "  使用 cap_width * cap_height 作为容量格子数。",
    "",
    "示例:",
    "\"minecraft:apple\": { \"width\": 1, \"height\": 1 }",
    "\"blockz:backpack_small\": { \"width\": 2, \"height\": 2, \"cap_width\": 3, \"cap_height\": 3 }",
    "\"blockz:backpack_example\": { \"width\": 3, \"height\": 3, \"cap_width\": 2, \"cap_height\": 2 }"
  ],
